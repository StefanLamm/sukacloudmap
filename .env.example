SUKA_ENVIRONMENT=development
SUKA_DATABASE_URL=sqlite:///./data/suka.db
SUKA_PUBLIC_ORIGIN=http://127.0.0.1:8000
SUKA_ALLOWED_HOSTS=["127.0.0.1","localhost"]
SUKA_SECURE_COOKIE=false
SUKA_SESSION_HOURS=12
# 正式部署：使用 HTTPS、secure cookie 与独立 PostgreSQL 账号。
# SUKA_DATABASE_URL=postgresql+psycopg://suka:YOUR_PASSWORD@127.0.0.1:5432/suka
# 高德地图：JS Key可发送到浏览器，安全密钥与Web服务Key仅在服务端读取。
SUKA_MAP_PROVIDER=AMAP
# SUKA_AMAP_JS_KEY=
# SUKA_AMAP_SECURITY_JS_CODE=
# SUKA_AMAP_WEB_SERVICE_KEY=
# 按当前控制台上限：Web服务各3次/秒，JS地图10次/秒；不设置月调用量限制。
# 同机主服务、试用和多进程必须共用此限流文件，不能按业务库拆分。
SUKA_AMAP_WEB_QPS=3
SUKA_AMAP_JS_QPS=10
# SUKA_AMAP_RATE_LIMIT_PATH=/absolute/path/to/shared/rate-limit.db
# 可选旧版开放地图：设置SUKA_MAP_PROVIDER=OPEN并配置以下HTTPS服务。
SUKA_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
SUKA_MAP_GEOCODER_URL=https://photon.komoot.io/api/
# 默认不调用外部算路。普通驾车参考：DRIVING + DRIVING_LIVE_CALLS_ENABLED=true。
SUKA_PLANNING_ROUTE_MODE=TRUCK
SUKA_DRIVING_LIVE_CALLS_ENABLED=false
SUKA_DRIVING_JOB_MAX_CALLS=unlimited
SUKA_TRUCK_LIVE_CALLS_ENABLED=false
SUKA_TRUCK_JOB_MAX_CALLS=unlimited
# 开启调用也不等于道路通过验收；指定发车时间及完整限行能力未核验时，专车仍阻止确认。
# 正常业务环境保持LIVE；TEST_GRID仅供独立test数据库，不能作为正式道路。
SUKA_PLANNING_ROAD_SOURCE=LIVE
# 优化算法：正式对照后选择配置；HYBRID联合局部搜索、大邻域搜索及整数候选组合。
SUKA_PLANNING_OPTIMIZER_PROFILE=HYBRID
SUKA_PLANNING_COMMON_PENALTY_MULTIPLIER=1
# 历史驾车实路参考图由采集/发布流程生成；保留采集时间，不能作为货车执行证据。
# SUKA_AMAP_REFERENCE_GRAPH_PATH=/absolute/path/to/reference-graph.db
# 同一主机运行试用服务时须使用不同Cookie名称；启动隔离测试.command已自动设置uat。
SUKA_COOKIE_NAMESPACE=

# 批量导入的地址后台自动关联；false仅暂停队列，不影响手动地图选点。
SUKA_MAP_AUTO_GEOCODE_ENABLED=true
